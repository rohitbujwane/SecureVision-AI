# Application Configuration
APP_NAME=AI Security Log Analyzer
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./security_analyzer.db

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_ROW_COUNT=500000

# Model
MODEL_DIR=./models
MODEL_CONTAMINATION=0.1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
